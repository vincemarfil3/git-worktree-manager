# Generated by install-native-host.ps1 - machine-specific (extension id, host.bat's absolute
# path). Never check in; setup.ps1/install-native-host.ps1 regenerates it on every machine.
native-host/com.storytabgroups.worktree.json

# Legacy generated manifest name, in case an older checkout still has one lying around.
native-host/com.vesta.worktree.json

# The real per-machine config now lives OUTSIDE this folder, at
# %LOCALAPPDATA%\story-tab-groups\stg-config.json - this repo only ships the .example template.
native-host/stg-config.json
tools/stg-config.json

# Scratch/setup output.
*.ps1.old
tools.old/

# Browser-automation debug output (console logs / page snapshots), not part of the extension.
.playwright-mcp/
